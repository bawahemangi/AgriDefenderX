msgid "Crop Health System"
msgstr "पीक आरोग्य प्रणाली"

msgid "Govt. of Maharashtra — MSInS"
msgstr "महाराष्ट्र शासन — MSInS"

msgid "Scan Crop"
msgstr "पीक स्कॅन करा"

msgid "Home"
msgstr "मुख्यपृष्ठ"

msgid "Dashboard"
msgstr "डॅशबोर्ड"

msgid "Admin"
msgstr "अ‍ॅडमिन"

msgid "Log out"
msgstr "लॉग आउट करा"

msgid "Log in"
msgstr "लॉग इन करा"

msgid "Register"
msgstr "नोंदणी करा"

msgid "Scan"
msgstr "स्कॅन"

msgid ""
"Problem Statement 26131 — Early detection & management of crop diseases and "
"pest infestations · Government of Maharashtra"
msgstr ""
"समस्या विधान २६१३१ — पीक रोग आणि कीड प्रादुर्भाव लवकर ओळखणे · महाराष्ट्र "
"शासन"

msgid "Language changed"
msgstr "भाषा बदलली"

msgid "Scan Your Crop"
msgstr "तुमचे पीक स्कॅन करा"

msgid ""
"Take a photo of your crop leaf — no account needed. Get an instant AI-"
"powered disease diagnosis and treatment advice."
msgstr ""
"तुमच्या पिकाच्या पानाचा फोटो काढा - खात्याची गरज नाही. त्वरित AI-आधारित "
"रोगाचे निदान आणि उपचाराचा सल्ला मिळवा."

msgid "Scan freely — no login needed!"
msgstr "मोफत स्कॅन करा - लॉग इनची गरज नाही!"

msgid ""
"Create a free account to save scan history and receive personalised "
"Marathi/Hindi advisories."
msgstr ""
"तुमचा स्कॅन इतिहास जतन करण्यासाठी आणि वैयक्तिकृत मराठी सल्ला मिळवण्यासाठी "
"मोफत खाते तयार करा."

msgid "Advisory Language"
msgstr "सल्ल्याची भाषा"

msgid "Upload or Capture Leaf Photo"
msgstr "पानाचा फोटो अपलोड करा किंवा काढा"

msgid "Tap to upload or drag & drop"
msgstr "अपलोड करण्यासाठी टॅप करा किंवा ड्रॉप करा"

msgid "Supports JPG, PNG, WEBP — clear photo of a single leaf works best"
msgstr "JPG, PNG, WEBP समर्थित — एका पानाचा स्पष्ट फोटो सर्वोत्तम काम करतो"

msgid "Camera / Gallery"
msgstr "कॅमेरा / गॅलरी"

msgid "Describe crop"
msgstr "पिकाचे वर्णन करा"

msgid "Describe the Problem"
msgstr "समस्येचे वर्णन करा"

msgid "optional"
msgstr "ऐच्छिक"

msgid "e.g. \"Yellow spots on tomato leaves, started 3 days ago\""
msgstr "उदा. \"टोमॅटोच्या पानांवर पिवळे डाग, ३ दिवसांपूर्वी सुरू झाले\""

msgid "Press the 🎙 button above to speak, or type directly here."
msgstr "बोलण्यासाठी वरील 🎙 बटण दाबा किंवा थेट येथे टाइप करा."

msgid "Detected"
msgstr "आढळले"

msgid "Analysis confidence"
msgstr "विश्लेषण आत्मविश्वास"

msgid "Treatment Advisory"
msgstr "उपचार सल्ला"

msgid "Listen to Advisory"
msgstr "सल्ला ऐका"

msgid "Want to save this scan?"
msgstr "हे स्कॅन जतन करायचे आहे का?"

msgid ""
"Create a free account to store your history, get voice advisories in "
"Marathi, and get flagged cases reviewed by a government expert."
msgstr ""
"तुमचा इतिहास साठवण्यासाठी आणि सरकारी तज्ञांकडून तपासणी मिळवण्यासाठी मोफत "
"खाते तयार करा."

msgid "Create Account"
msgstr "खाते तयार करा"

msgid "Scan Another Crop"
msgstr "दुसरे पीक स्कॅन करा"

msgid "Add New Farm"
msgstr "नवीन शेत जोडा"

msgid "Register a new farm to keep track of its crop health."
msgstr "पिकाच्या आरोग्यावर लक्ष ठेवण्यासाठी नवीन शेताची नोंदणी करा."

msgid "Farm Name"
msgstr "शेताचे नाव"

msgid "e.g. Tomato Field"
msgstr "उदा. टोमॅटोचे शेत"

msgid "Area (Acres)"
msgstr "क्षेत्र (एकर)"

msgid "District"
msgstr "जिल्हा"

msgid "Select"
msgstr "निवडा"

msgid "Taluka"
msgstr "तालुका"

msgid "Village"
msgstr "गाव"

msgid "Current Crop"
msgstr "सध्याचे पीक"

msgid "Save Farm"
msgstr "शेत जतन करा"

msgid "Cancel"
msgstr "रद्द करा"

msgid "Add"
msgstr "जोडा"

msgid "Welcome"
msgstr "स्वागत आहे"

msgid "My Farms"
msgstr "माझी शेते"

msgid "Acres"
msgstr "एकर"

msgid "No farms registered."
msgstr "कोणतेही शेत नोंदणीकृत नाही."

msgid "How it works"
msgstr "हे कसे कार्य करते"

msgid "Upload a crop photo"
msgstr "पिकाचा फोटो अपलोड करा"

msgid "AI detects diseases"
msgstr "AI रोग ओळखते"

msgid "Risk scored via Weather & Pests"
msgstr "हवामान आणि कीड द्वारे जोखीम स्कोअर"

msgid "Get actionable management advice"
msgstr "कृतीयोग्य व्यवस्थापन सल्ला मिळवा"

msgid "Recent Scans"
msgstr "अलीकडील स्कॅन"

msgid "View All"
msgstr "सर्व पहा"

msgid "Crop"
msgstr "पीक"

msgid "No crop scans yet"
msgstr "अद्याप कोणतेही पीक स्कॅन नाही"

msgid "Upload a photo of your crop to check its health."
msgstr "तुमच्या पिकाचे आरोग्य तपासण्यासाठी फोटो अपलोड करा."

msgid "Scan your first crop"
msgstr "तुमचे पहिले पीक स्कॅन करा"

msgid "You don't have a farm registered yet."
msgstr "तुमच्याकडे अद्याप कोणतेही शेत नोंदणीकृत नाही."

msgid "Add a farm"
msgstr "शेत जोडा"

msgid "to get started."
msgstr "सुरू करण्यासाठी."
